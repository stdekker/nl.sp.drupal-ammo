    $spec = array(
      'description' => 'Minimum chapter number for validation.',
      'type' => 'int',
      'size' => 'small',
      'default' => 1,
    );
    db_add_field('ammo_documents', 'chapter_min', $spec);
  }
  
  if (!db_field_exists('ammo_documents', 'chapter_max')) {
    $spec = array(
      'description' => 'Maximum chapter number for validation.',
      'type' => 'int',
      'size' => 'small',
    );
    db_add_field('ammo_documents', 'chapter_max', $spec);
  }
  
  // Add page range fields
  if (!db_field_exists('ammo_documents', 'page_min')) {
    $spec = array(
      'description' => 'Minimum page number for validation.',
      'type' => 'int',
      'size' => 'small',
      'default' => 1,
    );
    db_add_field('ammo_documents', 'page_min', $spec);
  }
  
  if (!db_field_exists('ammo_documents', 'page_max')) {
    $spec = array(
      'description' => 'Maximum page number for validation.',
      'type' => 'int',
      'size' => 'small',
    );
    db_add_field('ammo_documents', 'page_max', $spec);
  }
  
  // Add line maximum field
  if (!db_field_exists('ammo_documents', 'line_max')) {
    $spec = array(
      'description' => 'Maximum line number for validation.',
      'type' => 'int',
      'size' => 'small',
    );
    db_add_field('ammo_documents', 'line_max', $spec);
  }
  
  return t('Added validation range fields to documents table.');
}

