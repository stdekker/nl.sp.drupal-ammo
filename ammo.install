    $schema = ammo_schema();
    db_create_table('ammo_test_entries', $schema['ammo_test_entries']);
  }
}

/**
 * Add configurable location indicators to documents and amendments.
 */
function ammo_update_7014() {
  $schema = ammo_schema();
  if (!db_field_exists('ammo_documents', 'locators')) {
    db_add_field('ammo_documents', 'locators', $schema['ammo_documents']['fields']['locators']);
  }
  foreach (array('locator_values', 'group_value') as $field) {
    if (!db_field_exists('ammo_amendments', $field)) {
      db_add_field('ammo_amendments', $field, $schema['ammo_amendments']['fields'][$field]);
    }
  }
  if (!db_index_exists('ammo_amendments', 'document_group')) {
    db_add_index('ammo_amendments', 'document_group', $schema['ammo_amendments']['indexes']['document_group']);
  }
}

/**
 * Replace the statuses Overgenomen and Afgewezen with Beoordeeld.
 *
 * The outcome stays in the advice: an empty advice is filled from the old
 * status, and items whose advice contradicts their old status are reported.
 */
function ammo_update_7015() {
  $outcomes = array('accepted' => 'accept', 'rejected' => 'reject');
  $conflicts = array();
  foreach (array('amendment' => 'ammo_amendments', 'motion' => 'ammo_motions') as $type => $table) {
    foreach ($outcomes as $state => $advice) {
      db_update($table)
        ->fields(array('advice' => $advice))
        ->condition('state', $state)
        ->condition(db_or()->isNull('advice')->condition('advice', ''))
        ->execute();
      $ids = db_select($table, 't')->fields('t', array('id'))
        ->condition('state', $state)->condition('advice', $advice, '<>')
        ->execute()->fetchCol();
      if ($ids) {
        $conflicts[] = $type . ' ' . implode(', ', $ids) . ' (status ' . $state . ')';
      }
      db_update($table)->fields(array('state' => 'assessed'))->condition('state', $state)->execute();
    }
  }
  $allowed = variable_get('ammo_vote_request_allowed_statuses');
  if (is_array($allowed)) {
    $mapped = array();
    foreach (array_filter($allowed) as $status) {
      $status = isset($outcomes[$status]) ? 'assessed' : $status;
      $mapped[$status] = $status;
    }
    variable_set('ammo_vote_request_allowed_statuses', array_values($mapped));
  }
  $message = 'Overgenomen en Afgewezen zijn vervangen door Beoordeeld; de uitkomst staat in het advies.';
  if ($conflicts) {
    $message .= ' Advies wijkt af van de oude status bij: ' . implode('; ', $conflicts) . '.';
    watchdog('ammo', 'Update 7015: advies wijkt af van de oude status bij @items.', array('@items' => implode('; ', $conflicts)), WATCHDOG_WARNING);
  }
  return $message;
}

/**
 * Replace the submission deadline and the switches no_motions and allow_submitted_amendment_edit with four date ranges per meeting.
 */
function ammo_update_7016() {
  module_load_include('inc', 'ammo', 'ammo');
  $schema = ammo_schema();
  foreach (array_keys(ammo_meeting_ranges()) as $range) {
    foreach (array('_start', '_end') as $part) {
      if (!db_field_exists('ammo_meetings', $range . $part)) {
        db_add_field('ammo_meetings', $range . $part, $schema['ammo_meetings']['fields'][$range . $part]);
      }
    }
  }
  if (!db_field_exists('ammo_meetings', 'submission_closing_date')) {
    return 'De termijnen bestonden al.';
  }
  // Ranges hold whole days: an end runs to the end of its day.
  $end_of_day = "CONCAT(DATE(%s), ' 23:59:59')";
  db_update('ammo_meetings')
    ->expression('amendment_submission_end', sprintf($end_of_day, 'submission_closing_date'))
    ->isNotNull('submission_closing_date')
    ->execute();
  db_update('ammo_meetings')
    ->expression('motion_submission_end', sprintf($end_of_day, 'submission_closing_date'))
    ->isNotNull('submission_closing_date')
    ->condition(db_or()->isNull('no_motions')->condition('no_motions', 0))
    ->execute();
  db_update('ammo_meetings')
    ->expression('withdrawal_closing_date', sprintf($end_of_day, 'withdrawal_closing_date'))
    ->isNotNull('withdrawal_closing_date')
    ->execute();
  // The switch allowed changes without an end date; the meeting day ends them now.
  db_update('ammo_meetings')
    ->expression('amendment_change_end', sprintf($end_of_day, 'date'))
    ->isNotNull('date')
    ->condition('allow_submitted_amendment_edit', 1)
    ->execute();
  foreach (array('submission_closing_date', 'no_motions', 'allow_submitted_amendment_edit') as $field) {
    db_drop_field('ammo_meetings', $field);
  }
  return 'De inleverdatum, Geen moties en Ingediende wijzigingsvoorstellen wijzigen toestaan zijn vervangen door vier termijnen per bijeenkomst.';
}

/**
 * Merge the explanation of the status into the explanation of the advice.
 */
function ammo_update_7017() {
  foreach (array('ammo_amendments', 'ammo_motions') as $table) {
    if (!db_field_exists($table, 'state_supplement')) {
      continue;
    }
    // Keep both texts, advice first, unless one is empty or they are the same.
    db_update($table)
      ->expression('advice_supplement', "CASE WHEN advice_supplement IS NULL OR advice_supplement = '' OR advice_supplement = state_supplement THEN state_supplement ELSE CONCAT(advice_supplement, :separator, state_supplement) END", array(':separator' => "\n\n"))
      ->isNotNull('state_supplement')
      ->condition('state_supplement', '', '<>')
      ->execute();
    db_drop_field($table, 'state_supplement');
  }
  return 'Toelichting advies en Toelichting status zijn samengevoegd tot Toelichting.';
}
