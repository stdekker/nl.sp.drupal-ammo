      'id' => array(
        'description' => 'Primary key',
        'type' => 'serial',
        'size' => 'big',
        'not null' => TRUE,
      ),
      'date' => array(
        'description' => 'The meeting date.',
        'type' => 'datetime',
        'mysql_type' => 'datetime',
      ),
      'amendment_submission_start' => array(
        'description' => 'Start of the range in which amendments can be submitted (empty: open right away).',
        'type' => 'datetime',
        'mysql_type' => 'datetime',
