/**
 * Load a document.
 * @param $id
 * @return \stdClass
 */
function document_load($id) {
  return entity_load_single('document', $id);
}

/**
 * Load a meeting.
 * @param $id
 * @return \stdClass
 */
function meeting_load($id) {
  return entity_load_single('meeting', $id);
}

function ammo_permission() {
  return array(
    'administer ammo' => array(
      'title' => 'Beheer ammo',
    ),
    'administer amendments and motions' => array(
      'title' => 'Beheer wijzigingsvoorstellen en moties',
    ),
    'add amendments and motions' => array(
      'title' => 'Voeg wijzigingsvoorstellen en moties toe',
    ),
    'view submitted amendments and motions' => array(
      'title' => 'Bekijk ingediende wijzigingsvoorstellen en moties',
    ),
    'administer ammo mail settings' => array(
      'title' => 'Beheer ammo e-mailinstellingen',
      'description' => 'Zet de e-mailmeldingen per stap aan of uit.',
    ),
  );
}

function ammo_superadmin_access() {
  return user_access('administer ammo');
}

/**
 * Whether the user may switch mail notifications on and off; a permission of its own, apart from the admin rights.
 */
function ammo_mail_settings_access() {
  return user_access('administer ammo mail settings');
}

function ammo_admin_access() {
  return user_access('administer ammo') || user_access('administer amendments and motions');
}

function ammo_view_overview_access() {
  return user_access('view submitted amendments and motions') || ammo_admin_access();
}

function ammo_add_access($type = NULL) {
  return user_access('administer ammo') || user_access('administer amendments and motions') || user_access('add amendments and motions');
}

function ammo_add_motion_access() {
  return (user_access('administer ammo') || user_access('administer amendments and motions') || user_access('add amendments and motions')) && ammo_show_motions();
}

function ammo_view_motions_access() {
  return ammo_show_motions() && ammo_view_overview_access();
}

function ammo_show_motions_access() {
  return ammo_show_motions();
}

/**
 * Path of the page that shows a single amendment or motion.
 */
function ammo_item_view_path($type, $id) {
  return 'ammo/' . $type . '/view/' . $id;
}

/**
 * The action links of an amendment or motion for the current user, as theme('links') items, from the variables of its template_preprocess_*().
 */
function ammo_item_action_links($type, array $v) {
  $id = $v['entity_id'];
  $options = array('query' => !empty($v['destination']) ? $v['destination'] : ammo_get_destination());
  $owned = !empty($v['owners_branch']) || !empty($v['owners_member']);
  $no_vote_requests = empty($v['vote_requests']) || !is_array($v['vote_requests']);
  $links = array();
  if ($type === 'amendment') {
    if ($owned) {
      if ($v['edit_access']) {
        $links[] = array('title' => 'voorstel wijzigen', 'href' => 'ammo/amendment/edit/' . $id) + $options;
      }
      if (($v['admin_access'] && $v['advice_access']) || $v['superadmin_access']) {
        $links[] = array('title' => 'status/advies', 'href' => 'ammo/amendment/advice/' . $id) + $options;
      }
      if ($v['admin_access']) {
        $links[] = array('title' => 'indieners', 'href' => 'ammo/amendment/ownership/' . $id) + $options;
        if ($v['state'] !== 'spelling_grammar') {
          $links[] = array('title' => 'stemming', 'href' => 'ammo/amendment/vote-request/' . $id) + $options;
        }
      }
      if ($v['withdraw_access'] && $v['state'] !== 'withdrawn' && $v['state'] !== 'spelling_grammar') {
        if ($v['unsupported_branches'] && ammo_can_co_submit($v['state'])) {
          $links[] = array('title' => 'mede indienen', 'href' => 'ammo/support/add/branch/amendment/' . $id) + $options;
        }
        if ($v['supported_branches'] && !$v['withdraw_locked'] && $no_vote_requests) {
          $links[] = array('title' => 'voorstel / steun intrekken', 'href' => 'ammo/support/withdraw/branch/amendment/' . $id) + $options;
        }
        if ($v['removable_member_owners'] && !$v['withdraw_locked']) {
          $links[] = array('title' => 'intrekken individuele indieners', 'href' => 'ammo/support/withdraw/branchmembers/amendment/' . $id) + $options;
        }
      }
      if ($v['vote_request_access']) {
        if ($v['vote_unrequested_branches']) {
          $links[] = array('title' => 'stemming aanvragen', 'href' => 'ammo/vote_request/add/branch/amendment/' . $id) + $options;
        }
        if ($v['vote_requested_branches']) {
          $links[] = array('title' => 'stemming intrekken', 'href' => 'ammo/vote_request/withdraw/branch/amendment/' . $id) + $options;
        }
      }
    }
    return $links;
  }
  if ($owned || $v['admin_access'] || $v['superadmin_access']) {
    if ($v['edit_access'] || $v['admin_access']) {
      $links[] = array('title' => 'motie wijzigen', 'href' => 'ammo/motion/edit/' . $id) + $options;
    }
    if (($v['admin_access'] && $v['advice_access']) || $v['superadmin_access']) {
      $links[] = array('title' => 'status/advies', 'href' => 'ammo/motion/advice/' . $id) + $options;
    }
    if ($v['admin_access']) {
      $links[] = array('title' => 'indieners', 'href' => 'ammo/motion/ownership/' . $id) + $options;
      $links[] = array('title' => 'stemming', 'href' => 'ammo/motion/vote-request/' . $id) + $options;
    }
    if ($v['superadmin_access']) {
      $links[] = array('title' => 'verwijderen', 'href' => 'ammo/motion/delete/' . $id) + $options;
    }
  }
  if ($owned) {
    if (($v['withdraw_access'] && $v['state'] !== 'withdrawn' && !$v['rejected'] && $v['state'] !== 'spelling_grammar') || $v['admin_access']) {
      if ($v['unsupported_branches'] && ammo_can_co_submit($v['state'])) {
        $links[] = array('title' => 'mede indienen als afdeling', 'href' => 'ammo/support/add/branch/motion/' . $id) + $options;
      }
      if ($v['supported_branches'] && !$v['withdraw_locked'] && $no_vote_requests) {
        $links[] = array('title' => 'intrekken als afdeling', 'href' => 'ammo/support/withdraw/branch/motion/' . $id) + $options;
      }
      if ($v['removable_member_owners'] && !$v['withdraw_locked']) {
        $links[] = array('title' => 'intrekken individuele indieners', 'href' => 'ammo/support/withdraw/branchmembers/motion/' . $id) + $options;
      }
    }
    if ($v['vote_request_access'] || $v['admin_access']) {
      if ($v['vote_unrequested_branches']) {
        $links[] = array('title' => 'stemming aanvragen als afdeling', 'href' => 'ammo/vote_request/add/branch/motion/' . $id) + $options;
      }
      if ($v['vote_requested_branches']) {
        $links[] = array('title' => 'stemming aanvraag intrekken als afdeling', 'href' => 'ammo/vote_request/withdraw/branch/motion/' . $id) + $options;
      }
    }
  }
  return $links;
}

/**
 * Implements hook_mail().
 */
function ammo_mail($key, &$message, $params) {
  // Set reply-to header.
  $message['headers']['Reply-To'] = $params['reply_to'];
  $type = ($params['entity_type'] == 'amendment') ? 'Wijzigingsvoorstel' : 'Motie';
  $message['subject'] = $type . ' nr. ' . $params['id'];
  $path = url(ammo_item_view_path($params['entity_type'], $params['entity_id']), array('absolute' => TRUE));
  if ($params['entity_type'] === 'amendment') {
    $message['subject'] .= ' ' . $params['document_title'];
  };

  // Create messages.
  switch($key) {
  case 'vote_request':
    $message['subject'] .= ' - stemming aangevraagd door afdeling ' . $params['branch_display_name'];
    $message['body'][] = '<h3>Stemming aangevraagd door ' . $params['branch_display_name'] . '</h3>';
    $message['body'][] = $params['markup'];
    break;
    
  case 'vote_request_withdraw':
    $message['subject'] .= ' - stemming aanvraag ingetrokken door afdeling ' . $params['branch_display_name'];
    $message['body'][] = '<h3>Stemming aanvraag ingetrokken door ' . $params['branch_display_name'] . '</h3>';
    $message['body'][] = $params['markup'];
    break;
    
  case 'change_message':
    // Create messeage
    $message['body'][] = $params['markup'];
    $message['body'][] = '<hr /><h3>Wijzigingen</h3>';
    $message['body'][] = '<p>Gewijzigd door ' . $params['first_owner'] . '.</p>';
    foreach ($params['differences'] as $db_key => $values) {
      $message['body'][] = '<p>' . $values['fieldname'] . ': ' . $values['diff'] . '</p>';
    }
    $message['body'][] = '<hr /><p><a href="' . $path . '">Bekijk online</a></p>';
    break;
  case 'withdraw_ownership':
    // Create messeage
    if ($params['rest']) {
      $text = 'niet langer mede ingediend door';
    }
    else {
      $text = 'ingetrokken door';
    }
    $message['subject'] .= ' ' . $text . ' afdeling ' . $params['branch_display_name'];
    $message['body'][] = '<h3>' . ucfirst($text) . ' ' . $params['branch_display_name'] . '</h3>';
    $message['body'][] = $params['markup'];
    break;
  case 'support':
    // Create messeage
    if ($params['rest']) {
      $text = 'mede ingediend door';
    }
    else {
      $text = 'ingediend door';
    }
    $message['subject'] .= ' ' . $text . ' afdeling ' . $params['branch_display_name'];
    $message['body'][] = '<h3>' . ucfirst($text) . ' ' . $params['branch_display_name'] . '</h3>';
    $message['body'][] = $params['markup'];
    break;
  case 'delete_message':
    // Create messeage
    $type = ($params['entity_type'] == 'amendment') ? 'Wijzigingsvoorstel' : 'Motie';
    $message['subject'] .= ' is verwijderd.';
    $message['body'][] = $params['mail_text'];
    $message['body'][] = $params['markup'];
    break;
  }
}

function ammo_theme() {
  $theme = array(
    'overview_amendments' => array(
      'template' => 'amendments',
      'variables' => array(
      ),
    ),
    'overview_motions' => array(
      'template' => 'motions',
      'variables' => array(
      ),
    ),
    'overview_branch' => array(
      'template' => 'branch-overview',
      'variables' => array(
      ),
    ),
    'amendment_form' => array(
      'render element' => 'form',
      'template' => 'amendment-form',
    ),
    'ammo_locators_table' => array(
      'render element' => 'element',
      'file' => 'document.form.inc',
    ),
    'motion_form' => array(
      'render element' => 'form',
      'template' => 'motion-form',
    ),
    'amendment' => array(
      'variables' => array(),
      'template' => 'amendment',
    ),
    'motion' => array(
      'variables' => array(),
      'template' => 'motion',
    ),
    'intropage' => array(
      'variables' => array(),
      'template' => 'intropage',
    ),
    'print_amendments_by_location' => array(
      'variables' => array(),
      'template' => 'print_amendments_by_location',
    ),
    'print_amendments_by_number' => array(
      'variables' => array(),
      'template' => 'print_amendments_by_number',
    ),
    'print_motions_by_branch' => array(
      'variables' => array(),
      'template' => 'print_motions_by_branch',
    ),
    'print_motions_by_number' => array(
      'variables' => array(),
      'template' => 'print_motions_by_number',
    ),
    'export_meeting_xml' => array(
      'variables' => array(),
      'template' => 'export_meeting_xml',
    ),
    'ammo_mail_settings_steps' => array(
      'render element' => 'element',
      'file' => 'mail_settings.form.inc',
    ),
  );
  return $theme;
}

function template_preprocess_intropage(&$variables) {
  $vars['show_motions'] = ammo_show_motions();
  $variables = $variables + $vars;
}

function template_preprocess_amendment(&$variables) {
  global $user, $base_url;
  $user_wrapper = entity_metadata_wrapper('user', $user);
  
  // Fallback for when OpenID is disabled - allow admins to test
  $contact_id = NULL;
  try {
    if (isset($user_wrapper->field_contact_id)) {
      $contact_id = $user_wrapper->field_contact_id->value();
    }
  } catch (EntityMetadataWrapperException $e) {
    // Field doesn't exist, use fallback
  }
  
  // If no contact_id and user is admin, use user ID as fallback
  if (empty($contact_id) && ammo_admin_access()) {
    $contact_id = $user->uid;
  }


  if (isset($variables['entity_id'])) {
    $entity = entity_load_single('amendment', $variables['entity_id']);
    $document = entity_load_single('document', $entity->document_id);
    $meeting = entity_load_single('meeting', $document->meeting_id);
    $meeting_date = new DateTime($meeting->date);
    $meeting_date_formatted = $meeting_date->format('d F Y');
    $hide_state = $meeting->hide_state;
    $meeting_hide = $meeting->hide_meeting;
    $hide_advice = $meeting->hide_advice;
    $owners_member = ammo_get_related_contacts($entity->id, 'amendment', 'owner', 'member');
    $owners_branch = ammo_get_related_contacts($entity->id, 'amendment', 'owner', 'branch');
    $backers = ammo_get_related_contacts($entity->id, 'amendment', 'backer', 'member');
    $first_owner = ammo_get_first_owner('amendment', $entity->id);
    $owned_by_user = ammo_is_related($entity->id, 'amendment', 'owner', 'member');
    $backed_by_user = ammo_is_related($entity->id, 'amendment', 'backer', 'member');
    $branches = ammo_get_afdelingen($contact_id);
    $supported_branches = FALSE;
    $unsupported_branches = FALSE;
    $vote_requested_branches = FALSE;
    $vote_unrequested_branches = FALSE;
    if (!empty($branches)) {
      $vote_requests_branch = ammo_get_related_contacts($entity->id, 'amendment', 'vote_request', 'branch');
      foreach ($branches as $contact_id => $contact_display_name) {
        if (array_key_exists($contact_id, $owners_branch)) {
          $supported_branches = TRUE;
        }
        else {
          $unsupported_branches = TRUE;
        }
        if (array_key_exists($contact_id, $vote_requests_branch)) {
          $vote_requested_branches = TRUE;
        }
        elseif (ammo_vote_request_branch_allowed('amendment', $entity, $contact_id)) {
          $vote_unrequested_branches = TRUE;
        }
      }
    }
    $code = ammo_shurly('amendment', $entity->id);
    $locators = ammo_document_locators($document);
    $vars = array(
      'amendment_number' => check_plain(ammo_amendment_number($entity)),
      'location' => check_plain(ammo_amendment_location($entity, $locators, FALSE)),
      'heading' => check_plain(ammo_item_heading('amendment', $entity)),
      'show_heading' => !isset($variables['show_heading']) || $variables['show_heading'],
      'chapterized_id' => $entity->chapterized_id,
      'document_id' => $entity->document_id,
      'chapter' => $entity->chapter,
      'page' => $entity->page,
      'line' => $entity->line,
      'amendment_text' => $entity->amendment_text,
      'supplement' => $entity->supplement,
      'advice' => $entity->advice,
      'advice_supplement' => $entity->advice_supplement,
      'state' => $entity->state,
      'document_title' => $document->title,
      'document_description' => $document->description,
      'meeting_id' => $meeting->id,
      'meeting_title' => $meeting->title,
      'meeting_description' => $meeting->description,
      'meeting_date' => $meeting_date_formatted,
      'meeting_hide' => $meeting_hide,
      'advice_access' => ammo_advice_access($meeting->id),
      'edit_access' => empty($first_owner) ? FALSE : ammo_edit_access($meeting->id, $first_owner['branch_id'], 'amendment', $entity->id),
      'withdraw_access' => ammo_withdraw_access($meeting->id),
      // An item assessed as accepted (Overnemen) can no longer be withdrawn.
      'withdraw_locked' => !ammo_admin_access() && ammo_assessed_as($entity, 'accept'),
      'admin_access' => ammo_admin_access(),
      'superadmin_access' => ammo_superadmin_access(),
      'owners_member' => $owners_member,
      'owners_branch' => $owners_branch,
      'first_owner' => $first_owner,
      'co_owners' => ammo_get_co_owners($owners_member, $owners_branch),
      'backers' => $backers,
      'backed_by_user' => $backed_by_user,
      'owned_by_user' => $owned_by_user,
      'supported_branches' => $supported_branches,
      'unsupported_branches' => $unsupported_branches,
      'vote_requested_branches' => $vote_requested_branches,
      'vote_unrequested_branches' => $vote_unrequested_branches,
      'vote_request_access' => ammo_vote_request_access($meeting->id, $entity->state),
      'vote_requests' => ammo_get_vote_requests('amendment', $entity->id),
      'removable_member_owners' => ammo_removable_member_owners('amendment', $entity->id),
      'hide_advice' => $hide_advice,
      'hide_state' => $hide_state,
      'shurly' => $base_url . '/' . $code,
    );
    foreach($vars as $key => &$value) {
      if (in_array($key, array('owners_member', 'owners_branch', 'first_owner', 'co_owners', 'backers', 'vote_requests'))) continue;
      $value = ammo_sanitize_text($value);
    }
    $variables = $variables + $vars;
    $variables['actions'] = empty($variables['no_links']) ? ammo_item_action_links('amendment', $variables) : array();
  }
}

