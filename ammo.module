      $value = ammo_sanitize_text($value);
    }
    $variables = $variables + $vars;
    $variables['actions'] = empty($variables['no_links']) ? ammo_item_action_links('motion', $variables) : array();
  }
}

/**
 * Link to the submit form of an overview, when the user may submit to the meeting now.
 */
function ammo_overview_submit_link($meeting_id, $entity_type) {
  $meeting = entity_load_single('meeting', $meeting_id);
  $access = $entity_type == 'motion' ? ammo_add_motion_access() : ammo_add_access();
  if (!$meeting || !$access || !ammo_meeting_range_open($meeting, $entity_type . '_submission')) {
    return '';
  }
  return l($entity_type == 'motion' ? 'Motie indienen' : 'Wijzigingsvoorstel indienen', 'ammo/' . $entity_type);
}

function template_preprocess_overview_amendments(&$variables) {
  module_load_include('inc', 'ammo', 'amendments-pager');
  $variables += ammo_amendments_page($variables['meeting_id'], $_GET);
  $variables['submit_link'] = ammo_overview_submit_link($variables['meeting_id'], 'amendment');
  if (!empty($variables['meeting']['selected_document'])) {
    $variables['destination'] = array('destination' => url('ammo/amendments/' . $variables['meeting']['id'], array('query' => array('document' => $variables['meeting']['selected_document'], 'chapter' => $variables['meeting']['selected_chapter']))));
  }
}

function template_preprocess_overview_motions(&$variables) {
  if (isset($variables['meeting_id'])) {
    $meeting = entity_load_single('meeting', $variables['meeting_id']);
    $data['meeting'] = array(
      'id' => $meeting->id,
      'meeting_id' => $meeting->id,
      'title' => check_plain($meeting->title),
      'description' => check_plain($meeting->description),
      'date' => $meeting->date,
      'hide' => $meeting->hide_meeting,
      'admin_access' => ammo_admin_access(),
    );
    // Include blocked motions for admins
    $admin_access = ammo_admin_access();
    if ($admin_access) {
      $motions_results = db_query("SELECT id, state, motion_id FROM {ammo_motions} WHERE meeting_id = :meeting_id AND state != 'concept' ORDER BY motion_id", array(":meeting_id" => $meeting->id));
    } else {
      $motions_results = db_query("SELECT id, state, motion_id FROM {ammo_motions} WHERE meeting_id = :meeting_id AND state != 'concept' AND state != 'blocked' ORDER BY motion_id", array(":meeting_id" => $meeting->id));
    }
    foreach ($motions_results as $motion) {
      $owners_member = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'member');
      $owners_branch = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'branch');
      
      // Store motions in a simple flat array ordered by motion_id
      $data['meeting']['motions'][$motion->id] = array(
        'id' => $motion->id,
        'owners_member' => $owners_member,
        'owners_branch' => $owners_branch,
        'state' => $motion->state,
        'motion_id' => $motion->motion_id,
      );
      
      // Store totals.
      if (empty($data['meeting']['motion_totals'])) {
        $states = array_keys(ammo_states());
        foreach ($states as $state) {
          $data['meeting']['motion_totals'][$state] = 0;
        }
      }
      $data['meeting']['motion_totals'][$motion->state]++;
    }
    $data['submit_link'] = ammo_overview_submit_link($meeting->id, 'motion');
    $variables = $variables + $data;
  }
}

function template_preprocess_overview_branch(&$variables) {
  module_load_include('inc', 'ammo', 'branch-overview');
  $variables += ammo_branch_overview_page($variables['meeting_id'], $variables['selected_branches']);
}

function template_preprocess_print_amendments_by_location(&$variables) {
  $data = _ammo_preprocess_meeting_data($variables['values']['meeting']);
  $documents_results = db_query("SELECT * FROM {ammo_documents} WHERE meeting_id = :meeting_id ORDER BY title", array(":meeting_id" => $variables['values']['meeting']));
  foreach ($documents_results as $document) {
    // Store document data.
    $data['meeting']['documents'][$document->id] = array(
      'id' => $document->id,
      'title' => check_plain($document->title),
      'description' => check_plain($document->description),
      'meeting_id' => check_plain($document->meeting_id),
    );
    $statuses = array_filter($variables['values']['status']);
    $query = "SELECT * FROM {ammo_amendments} WHERE document_id = :document_id AND state IN (:states)";
    $amendments_results = db_query($query, array(":document_id" => $document->id, ':states' => $statuses))->fetchAllAssoc('id');
    $locators = ammo_document_locators($document);
    ammo_sort_amendments($amendments_results, $locators);
    foreach ($amendments_results as $amendment) {
      // Check if we should filter by vote requests
      if (!empty($variables['values']['vote_requested_only'])) {
        $vote_requests = ammo_get_vote_requests('amendment', $amendment->id);
        if (empty($vote_requests) || count($vote_requests) == 0) {
          continue; // Skip amendments without vote requests
        }
      }
      
      // Get owners.
      $owners_member = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'member');
      $owners_branch = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'branch');
      $backers = ammo_get_related_contacts($amendment->id, 'amendment', 'backer');
      $vote_requests = ammo_get_vote_requests('amendment', $amendment->id);
      // Store group data.
      $group = ammo_amendment_group($amendment);
      $data['meeting']['documents'][$document->id]['chapters'][$group]['nr'] = $group;
      // Store amendment data.
      $data['meeting']['documents'][$document->id]['chapters'][$group]['amendments'][$amendment->id] = array(
        'id' => $amendment->id,
        'number' => check_plain(ammo_amendment_number($amendment)),
        'location' => check_plain(ammo_amendment_location($amendment, $locators)),
        'chapterized_id' => $amendment->chapterized_id,
        'chapter' => $amendment->chapter,
        'page' => $amendment->page,
        'line' => $amendment->line,
        'amendment_text' => $amendment->amendment_text,
        'supplement' => $amendment->supplement,
        'advice' => $amendment->advice,
        'advice_supplement' => $amendment->advice_supplement,
        'state' => $amendment->state,
        'owners_member' => $owners_member,
        'owners_branch' => $owners_branch,
        'backers' => $backers,
        'vote_requests' => $vote_requests,
      );
      foreach ($data['meeting']['documents'][$document->id]['chapters'][$group]['amendments'][$amendment->id] as $key => &$value) {
        if (in_array($key, array('owners_member', 'owners_branch', 'backers', 'vote_requests'))) continue;
        $value = ammo_sanitize_text($value);
      }
    }
  }
  $variables['meeting'] = $data['meeting'];
  $variables['meeting']['notespacetext'] = '<p><br/><br/><br/><br/></p>';
}

function template_preprocess_print_amendments_by_number(&$variables) {
  $data = _ammo_preprocess_meeting_data($variables['values']['meeting']);
  $documents_results = db_query("SELECT * FROM {ammo_documents} WHERE meeting_id = :meeting_id ORDER BY title", array(":meeting_id" => $variables['values']['meeting']));
  foreach ($documents_results as $document) {
    // Store document data.
    $data['meeting']['documents'][$document->id] = array(
      'id' => $document->id,
      'title' => check_plain($document->title),
      'description' => check_plain($document->description),
      'meeting_id' => check_plain($document->meeting_id),
    );
    $statuses = array_filter($variables['values']['status']);
    $query = "SELECT * FROM {ammo_amendments} WHERE document_id = :document_id AND state IN (:states)";
    $amendments_results = db_query($query, array(":document_id" => $document->id, ':states' => $statuses))->fetchAllAssoc('id');
    $locators = ammo_document_locators($document);
    ammo_sort_amendments($amendments_results, $locators, FALSE);
    foreach ($amendments_results as $amendment) {
      // Check if we should filter by vote requests
      if (!empty($variables['values']['vote_requested_only'])) {
        $vote_requests = ammo_get_vote_requests('amendment', $amendment->id);
        if (empty($vote_requests) || count($vote_requests) == 0) {
          continue; // Skip amendments without vote requests
        }
      }
      
      // Get owners.
      $owners_member = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'member');
      $owners_branch = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'branch');
      $backers = ammo_get_related_contacts($amendment->id, 'amendment', 'backer');
      $vote_requests = ammo_get_vote_requests('amendment', $amendment->id);
      // Store amendment data.
      $data['meeting']['amendments'][$amendment->id] = array(
        'id' => $amendment->id,
        'number' => check_plain(ammo_amendment_number($amendment)),
        'location' => check_plain(ammo_amendment_location($amendment, $locators)),
        'chapterized_id' => $amendment->chapterized_id,
        'document_id' => check_plain($amendment->document_id),
        'document_title' => check_plain($document->title),
        'chapter' => check_plain($amendment->chapter),
        'page' => check_plain($amendment->page),
        'line' => check_plain($amendment->line),
        'amendment_text' => check_plain($amendment->amendment_text),
        'supplement' => check_plain($amendment->supplement),
        'advice' => check_plain($amendment->advice),
        'advice_supplement' => check_plain($amendment->advice_supplement),
        'state' => $amendment->state,
        'owners_member' => $owners_member,
        'owners_branch' => $owners_branch,
        'backers' => $backers,
        'vote_requests' => $vote_requests,
      );
      foreach ($data['meeting']['amendments'][$amendment->id] as $key => &$value) {
        if (in_array($key, array('owners_member', 'owners_branch', 'backers', 'vote_requests'))) continue;
        $value = ammo_sanitize_text($value);
      }
    }
  }
  $variables['meeting'] = $data['meeting'];
  $variables['meeting']['notespacetext'] = '<p><br/><br/><br/><br/></p>';
}

function template_preprocess_print_motions_by_branch(&$variables) {
  $data = _ammo_preprocess_meeting_data($variables['values']['meeting']);
  // Include blocked motions for admins in print view
  $admin_access = ammo_admin_access();
  $statuses = array_filter($variables['values']['status']);
  $query = "SELECT * FROM {ammo_motions} WHERE meeting_id = :meeting_id AND state IN (:states)";
  $args = array(":meeting_id" => $variables['values']['meeting'], ':states' => $statuses);
  if ($admin_access) {
    $motions_results = db_query($query, $args);
  } else {
    $query .= " AND state != 'blocked'";
    $motions_results = db_query($query, $args);
  }
  foreach ($motions_results as $motion) {
    $owners_member = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'member');
    $owners_branch = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'branch');
    $backers = ammo_get_related_contacts($motion->id, 'motion', 'backer');
    $first_owner = ammo_get_first_owner('motion', $motion->id);
    $data['meeting']['branches'][$first_owner['branch_id']]['first_owner'] = $first_owner;
    $data['meeting']['branches'][$first_owner['branch_id']]['motions'][$motion->id] = array(
      'id' => $motion->id,
      'motion_id' => $motion->motion_id,
      'consideration_opening' => $motion->consideration_opening,
      'consideration_body' => $motion->consideration_body,
      'follow_up_opening' => $motion->follow_up_opening,
      'follow_up_body' => $motion->follow_up_body,
      'supplement' => $motion->supplement,
      'advice' => $motion->advice,
      'advice_supplement' => $motion->advice_supplement,
      'state' => $motion->state,
      'owners_member' => $owners_member,
      'owners_branch' => $owners_branch,
      'backers' => $backers,
    );
    foreach ($data['meeting']['branches'][$first_owner['branch_id']]['motions'][$motion->id] as $key => &$value) {
      if (in_array($key, array('owners_member', 'owners_branch', 'backers'))) continue;
      $value = ammo_sanitize_text($value);
    }
  }
  $variables['meeting'] = $data['meeting'];
  $variables['meeting']['notespacetext'] = '<p><br/><br/><br/><br/></p>';
}

function template_preprocess_print_motions_by_number(&$variables) {
  $data = _ammo_preprocess_meeting_data($variables['values']['meeting']);
  // Include blocked motions for admins in print view
  $admin_access = ammo_admin_access();
  $statuses = array_filter($variables['values']['status']);
  $query = "SELECT * FROM {ammo_motions} WHERE meeting_id = :meeting_id AND state IN (:states)";
  $args = array(":meeting_id" => $variables['values']['meeting'], ':states' => $statuses);
  if ($admin_access) {
    $motions_results = db_query($query, $args);
  } else {
    $query .= " AND state != 'blocked'";
    $motions_results = db_query($query, $args);
  }
  foreach ($motions_results as $motion) {
    $owners_member = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'member');
    $owners_branch = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'branch');
    $backers = ammo_get_related_contacts($motion->id, 'motion', 'backer');
    $data['meeting']['motions'][$motion->id] = array(
      'id' => $motion->id,
      'motion_id' => $motion->motion_id,
      'consideration_opening' => $motion->consideration_opening,
      'consideration_body' => $motion->consideration_body,
      'follow_up_opening' => $motion->follow_up_opening,
      'follow_up_body' => $motion->follow_up_body,
      'supplement' => $motion->supplement,
      'advice' => $motion->advice,
      'advice_supplement' => $motion->advice_supplement,
      'state' => $motion->state,
      'owners_member' => $owners_member,
      'owners_branch' => $owners_branch,
      'backers' => $backers,
    );
    foreach ($data['meeting']['motions'][$motion->id] as $key => &$value) {
      if (in_array($key, array('owners_member', 'owners_branch', 'backers'))) continue;
      $value = ammo_sanitize_text($value);
    }
  }
  $variables['meeting'] = $data['meeting'];
  $variables['meeting']['notespacetext'] = '<p><br/><br/><br/><br/></p>';
}

function template_preprocess_export_meeting_xml(&$variables) {
  $data = _ammo_preprocess_meeting_data($variables['values']['meeting']);
  $documents_results = db_query("SELECT * FROM {ammo_documents} WHERE meeting_id = :meeting_id ORDER BY id", array(":meeting_id" => $variables['values']['meeting']));
  foreach ($documents_results as $document) {
    // Store document data.
    $data['meeting']['documents'][$document->id] = array(
      'id' => $document->id,
      'title' => $document->title,
      'description' => $document->description,
      'meeting_id' => $document->meeting_id,
    );
    // Taken over: assessed with the advice to accept.
    $amendments_results = db_query("SELECT * FROM {ammo_amendments} WHERE document_id = :document_id AND state = 'assessed' AND advice = 'accept'", array(":document_id" => $document->id))->fetchAllAssoc('id');
    $locators = ammo_document_locators($document);
    $grouping = ammo_grouping_locator($locators);
    ammo_sort_amendments($amendments_results, $locators, FALSE);
    foreach ($amendments_results as $amendment) {
      // Get owners.
      $owners_member = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'member');
      $owners_branch = ammo_get_related_contacts($amendment->id, 'amendment', 'owner', 'branch');
      $backers = ammo_get_related_contacts($amendment->id, 'amendment', 'backer');
      // Store group data.
      $group = ammo_amendment_group($amendment);
      $data['meeting']['documents'][$document->id]['chapters'][$group]['chapter_nr'] = htmlspecialchars($group, ENT_QUOTES | ENT_XML1);
      $data['meeting']['documents'][$document->id]['chapters'][$group]['group_label'] = htmlspecialchars($grouping['label'], ENT_QUOTES | ENT_XML1);
      // Store amendment data.
      $data['meeting']['documents'][$document->id]['chapters'][$group]['amendments'][$amendment->id] = array(
        'id' => $amendment->id,
        'number' => ammo_amendment_number($amendment),
        'location' => ammo_amendment_location($amendment, $locators, TRUE, TRUE),
        'chapterized_id' => $amendment->chapterized_id,
        'chapter' => $amendment->chapter,
        'page' => $amendment->page,
        'line' => $amendment->line,
        'amendment_text' => $amendment->amendment_text,
        'supplement' => $amendment->supplement,
        'advice' => $amendment->advice,
        'advice_supplement' => $amendment->advice_supplement,
        'state' => $amendment->state,
        'owners_member' => $owners_member,
        'owners_branch' => $owners_branch,
        'backers' => $backers,
      );
      foreach ($data['meeting']['documents'][$document->id]['chapters'][$group]['amendments'][$amendment->id] as $key => &$value) {
        if (in_array($key, array('owners_member', 'owners_branch', 'backers'))) continue;
        $value = ammo_strip_invalid_xml($value);
        $value = htmlspecialchars($value, ENT_QUOTES | ENT_XML1);
      }
    }
  }
  $motions_results = db_query("SELECT * FROM {ammo_motions} WHERE meeting_id = :meeting_id AND state = 'assessed' AND advice = 'accept'", array(":meeting_id" => $variables['values']['meeting']));
  foreach ($motions_results as $motion) {
    $owners_member = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'member');
    $owners_branch = ammo_get_related_contacts($motion->id, 'motion', 'owner', 'branch');
    $backers = ammo_get_related_contacts($motion->id, 'motion', 'backer');
    $data['meeting']['motions'][$motion->id] = array(
      'id' => $motion->id,
      'motion_id' => $motion->motion_id,
      'consideration_opening' => $motion->consideration_opening,
      'consideration_body' => $motion->consideration_body,
      'follow_up_opening' => $motion->follow_up_opening,
      'follow_up_body' => $motion->follow_up_body,
      'supplement' => $motion->supplement,
      'advice' => $motion->advice,
      'advice_supplement' => $motion->advice_supplement,
      'state' => $motion->state,
      'owners_member' => $owners_member,
      'owners_branch' => $owners_branch,
      'backers' => $backers,
    );
    foreach ($data['meeting']['motions'][$motion->id] as $key => &$value) {
      if (in_array($key, array('owners_member', 'owners_branch', 'backers'))) continue;
      $value = htmlspecialchars($value, ENT_QUOTES | ENT_XML1);
    }
  }
  $variables['meeting'] = $data['meeting'];
}

function _ammo_preprocess_meeting_data($meeting_id) {
  $meeting = entity_load_single('meeting', $meeting_id);
  // Store meeting data.
  $data['meeting'] = array(
    'id' => $meeting->id,
    'title' => check_plain($meeting->title),
    'description' => check_plain($meeting->description),
    'date' => $meeting->date,
    'withdrawal_closing_date' => $meeting->withdrawal_closing_date,
  );
  return $data;
}

/**
 * Implements hook_entity_info().
 */
/**
 * Implements hook_entity_presave(): an amendment or motion records when it was created and last saved.
 */
function ammo_entity_presave($entity, $type) {
  if ($type === 'amendment' || $type === 'motion') {
    if (!empty($entity->is_new) || empty($entity->id)) {
      $entity->created = REQUEST_TIME;
    }
    $entity->changed = REQUEST_TIME;
  }
}

/**
 * The created or changed date of an amendment or motion, or an empty string when it is not known.
 */
function ammo_item_date($item, $field) {
  $item = (object) $item;
  return empty($item->$field) ? '' : format_date($item->$field, 'custom', 'j F Y, H:i');
}

