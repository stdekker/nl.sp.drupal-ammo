/**
 * Implements hook_init().
 */
function ammo_init() {
  module_load_include("inc", "ammo", "ammo");
}

/**
 * Sanitize text by stripping HTML tags, normalizing punctuation, applying nl2br, and limiting consecutive <br> tags.
 * 
 * @param string $text
 *   The text to sanitize.
 * @param bool $strip_html
 *   Whether to strip HTML tags from the text. Default TRUE.
 * @param array $allowed_tags
 *   Array of allowed HTML tags if strip_html is TRUE. Default empty (strip all).
 * @return string
 *   The sanitized text with HTML stripped, punctuation normalized, and consecutive <br> tags limited to maximum 2.
 */
function ammo_sanitize_text($text, $strip_html = TRUE, $allowed_tags = array()) {
  if (empty($text)) {
    return $text;
  }
  
  // Strip HTML tags if requested
  if ($strip_html) {
    if (empty($allowed_tags)) {
      // Strip all HTML tags
      $text = strip_tags($text);
    } else {
      // Strip HTML tags but allow specified ones
      $text = strip_tags($text, '<' . implode('><', $allowed_tags) . '>');
    }
  }
  
  // Normalize multiple exclamation marks to single exclamation mark
  // Matches patterns like !!!, !!1!!1, !!!!!, etc. but preserves "1!"
  $text = preg_replace('/(!!+|[!1]{3,})/i', '!', $text);
  
  // Apply nl2br to convert newlines to <br> tags
  $text = nl2br($text);
  
  // Limit consecutive <br> tags to maximum 2
  // This regex matches 3 or more consecutive <br> tags (with optional spaces/attributes)
  // and replaces them with exactly 2 <br> tags
  $text = preg_replace('/(<br\s*\/?>(\s*)){3,}/i', '<br /><br />', $text);
  
  return $text;
}

