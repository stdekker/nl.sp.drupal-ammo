      'edit_access' => empty($first_owner) ? FALSE : ammo_edit_access($meeting->id, $first_owner['branch_id'], 'motion', $entity->id),
      'withdraw_access' => ammo_withdraw_access($meeting->id),
      // An item assessed as accepted (Overnemen) can no longer be withdrawn.
      'withdraw_locked' => !ammo_admin_access() && ammo_assessed_as($entity, 'accept'),
